<%- include('../partials/head', { title: 'New order' }) %>
<%- include('../partials/shell_start', { panel: 'user', active: 'order' }) %>

<h1 class="text-2xl font-bold mb-6">New order</h1>

<div class="card p-6 max-w-2xl">
  <% if (favoriteIds.length) { %>
  <div class="mb-5">
    <div class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-2">★ Your favorites</div>
    <div class="flex flex-wrap gap-2" id="favChips"></div>
  </div>
  <% } %>

  <form method="POST" action="/order/new" class="space-y-5">
    <div>
      <label class="text-sm font-semibold">Category</label>
      <select id="categorySelect" class="input mt-1">
        <option value="">— Select category —</option>
        <% categories.forEach(function(c){ %>
          <option value="<%= c.id %>" <%= c.service_count == 0 ? 'disabled' : '' %>><%= c.name %> (<%= c.service_count %>)</option>
        <% }) %>
      </select>
    </div>
    <div>
      <div class="flex items-center justify-between">
        <label class="text-sm font-semibold">Service</label>
        <button type="button" id="favToggle" class="text-xl leading-none text-slate-300 hover:text-amber-400 hidden" title="Toggle favorite">☆</button>
      </div>
      <select id="serviceSelect" name="service_id" class="input mt-1" required>
        <option value="">— Select a category first —</option>
      </select>
      <p id="serviceInfo" class="text-xs text-slate-500 mt-2"></p>
      <% if (discountPct > 0) { %>
      <p class="mt-2"><span class="inline-block bg-indigo-100 text-indigo-700 text-xs font-bold px-2 py-1 rounded-full">⭐ VIP <%= discountPct %>% loyalty discount applied</span></p>
      <% } %>
    </div>
    <div>
      <label class="text-sm font-semibold">Link</label>
      <input class="input mt-1" name="link" placeholder="https://..." required>
      <p class="text-xs text-slate-500 mt-1">Profile, post or video URL the service applies to.</p>
    </div>
    <div>
      <label class="text-sm font-semibold">Quantity</label>
      <input id="qtyInput" class="input mt-1" type="number" name="quantity" min="1" required placeholder="e.g. 1000">
    </div>
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center justify-between">
      <div>
        <div class="text-xs font-bold text-slate-400 uppercase">Total charge</div>
        <div class="text-2xl font-black" id="priceDisplay">0.00 <%= settings.currency %></div>
        <% if (discountPct > 0) { %><div class="text-xs text-indigo-600 font-semibold" id="discountNote"></div><% } %>
      </div>
      <div class="text-right">
        <div class="text-xs font-bold text-slate-400 uppercase">Your balance</div>
        <div class="text-lg font-bold"><%= money(currentUser.balance) %> <%= settings.currency %></div>
      </div>
    </div>
    <button class="btn btn-primary w-full py-3" type="submit">Place order</button>
  </form>
</div>

<script>
const services = <%- JSON.stringify(services.map(s => ({
  id: s.id, category_id: s.category_id, name: s.name,
  rate: Number(s.rate_per_1000), min: s.min, max: s.max
}))) %>;
const favoriteIds = new Set(<%- JSON.stringify(favoriteIds) %>);
const discountPct = <%- JSON.stringify(discountPct) %>;
const discountMult = 1 - discountPct / 100;
const currency = <%- JSON.stringify(settings.currency) %>;
const catSel = document.getElementById('categorySelect');
const svcSel = document.getElementById('serviceSelect');
const qtyInput = document.getElementById('qtyInput');
const info = document.getElementById('serviceInfo');
const priceDisplay = document.getElementById('priceDisplay');
const discountNote = document.getElementById('discountNote');
const favToggle = document.getElementById('favToggle');

function fmt(n){ return Number(n).toLocaleString('en-US'); }
function effRate(s){ return s.rate * discountMult; }

function serviceLabel(s){
  const star = favoriteIds.has(s.id) ? '★ ' : '';
  return star + s.name + ' — ' + effRate(s).toFixed(2) + ' ' + currency + '/1k';
}

function populateServices(cid){
  svcSel.innerHTML = '<option value="">— Select service —</option>';
  services
    .filter(s => String(s.category_id) === String(cid))
    .sort((a, b) => (favoriteIds.has(b.id) - favoriteIds.has(a.id)))
    .forEach(s => {
      const o = document.createElement('option');
      o.value = s.id;
      o.textContent = serviceLabel(s);
      svcSel.appendChild(o);
    });
  updateInfo();
}

// Favorite quick chips
const favChips = document.getElementById('favChips');
if (favChips) {
  services.filter(s => favoriteIds.has(s.id)).forEach(s => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'btn btn-sm btn-slate';
    b.textContent = '★ ' + (s.name.length > 40 ? s.name.slice(0, 40) + '…' : s.name);
    b.addEventListener('click', () => {
      catSel.value = String(s.category_id);
      populateServices(s.category_id);
      svcSel.value = String(s.id);
      updateInfo();
    });
    favChips.appendChild(b);
  });
}

catSel.addEventListener('change', () => populateServices(catSel.value));
svcSel.addEventListener('change', updateInfo);
qtyInput.addEventListener('input', updateInfo);

favToggle.addEventListener('click', async () => {
  const s = selected();
  if (!s) return;
  const res = await fetch('/favorites/toggle', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ service_id: s.id }),
  });
  const data = await res.json();
  if (data.ok) {
    if (data.favorited) favoriteIds.add(s.id); else favoriteIds.delete(s.id);
    const cid = catSel.value, cur = svcSel.value;
    populateServices(cid);
    svcSel.value = cur;
    updateInfo();
  }
});

function selected(){ return services.find(s => String(s.id) === String(svcSel.value)); }

function updateInfo(){
  const s = selected();
  if (!s) {
    info.textContent = '';
    priceDisplay.textContent = '0.00 ' + currency;
    favToggle.classList.add('hidden');
    if (discountNote) discountNote.textContent = '';
    return;
  }
  favToggle.classList.remove('hidden');
  favToggle.textContent = favoriteIds.has(s.id) ? '★' : '☆';
  favToggle.classList.toggle('text-amber-400', favoriteIds.has(s.id));
  const r = effRate(s);
  info.textContent = 'Rate: ' + r.toFixed(2) + ' ' + currency + ' per 1000 · Min ' + fmt(s.min) + ' · Max ' + fmt(s.max);
  const q = parseInt(qtyInput.value, 10);
  const charge = Number.isFinite(q) && q > 0 ? (r * q / 1000) : 0;
  priceDisplay.textContent = charge.toFixed(2) + ' ' + currency;
  if (discountNote) {
    discountNote.textContent = discountPct > 0 && Number.isFinite(q) && q > 0
      ? 'Includes VIP ' + discountPct + '% off (saved ' + (s.rate * q / 1000 - charge).toFixed(2) + ' ' + currency + ')'
      : '';
  }
}
</script>

<%- include('../partials/shell_end') %>
