<%- include('../partials/head', { title: 'Add funds' }) %>
<%- include('../partials/shell_start', { panel: 'user', active: 'funds' }) %>

<h1 class="text-2xl font-bold mb-2">Add funds</h1>
<p class="text-sm text-slate-500 mb-6">Send payment to one of the accounts below, then submit the form. Your balance is credited after admin verification.</p>

<% if (!methods.length) { %>
  <div class="card p-6 text-sm text-slate-500">No payment methods are currently enabled. Please contact support.</div>
<% } else { %>
<div class="grid md:grid-cols-2 gap-4 mb-8">
  <% methods.forEach(function(m){ %>
  <div class="card p-5">
    <div class="flex items-center justify-between">
      <h3 class="font-bold text-lg"><%= m.name %></h3>
      <span class="text-xs bg-slate-100 text-slate-500 px-2 py-1 rounded-full font-semibold"><%= m.type %></span>
    </div>
    <div class="mt-3 text-sm space-y-1">
      <div><span class="text-slate-500">Account title:</span> <span class="font-semibold"><%= m.account_title || '-' %></span></div>
      <div><span class="text-slate-500">Account number:</span> <span class="font-mono font-semibold text-indigo-700"><%= m.account_number || '-' %></span></div>
    </div>
    <% if (m.instructions) { %>
    <pre class="instructions text-xs text-slate-500 bg-slate-50 border border-slate-200 rounded-lg p-3 mt-3"><%= m.instructions %></pre>
    <% } %>
  </div>
  <% }) %>
</div>

<div class="card p-6 max-w-xl">
  <h2 class="font-bold mb-4">Submit payment</h2>
  <form method="POST" action="/funds/add" enctype="multipart/form-data" class="space-y-4">
    <div>
      <label class="text-sm font-semibold">Payment method</label>
      <select name="method_id" class="input mt-1" required>
        <% methods.forEach(function(m){ %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="text-sm font-semibold">Amount (<%= settings.currency %>)</label>
      <input class="input mt-1" type="number" name="amount" min="50" step="0.01" required placeholder="e.g. 1000">
    </div>
    <div>
      <label class="text-sm font-semibold">Transaction ID</label>
      <input class="input mt-1" name="txn_id" required placeholder="TID / TRX ID from your receipt">
    </div>
    <div>
      <label class="text-sm font-semibold">Receipt screenshot (optional)</label>
      <input class="input mt-1" type="file" name="receipt" accept="image/png,image/jpeg,image/gif,image/webp">
      <p class="text-xs text-slate-500 mt-1">PNG, JPG, GIF or WEBP, max 5 MB.</p>
    </div>
    <button class="btn btn-primary w-full py-3" type="submit">Submit fund request</button>
  </form>
</div>
<% } %>

<%- include('../partials/shell_end') %>
