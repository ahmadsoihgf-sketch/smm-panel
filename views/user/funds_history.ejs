<%- include('../partials/head', { title: 'Fund history' }) %>
<%- include('../partials/shell_start', { panel: 'user', active: 'fundshistory' }) %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Fund history</h1>
  <a href="/funds/add" class="btn btn-primary btn-sm">＋ Add funds</a>
</div>

<div class="card overflow-hidden">
  <% if (!requests.length) { %>
    <p class="p-5 text-sm text-slate-500">No fund requests yet.</p>
  <% } else { %>
  <div class="overflow-x-auto">
  <table class="w-full">
    <thead><tr><th class="th">ID</th><th class="th">Method</th><th class="th">Amount</th><th class="th">Txn ID</th><th class="th">Status</th><th class="th">Note</th><th class="th">Date</th></tr></thead>
    <tbody>
      <% requests.forEach(function(r){ %>
      <tr>
        <td class="td font-mono">#<%= r.id %></td>
        <td class="td"><%= r.method_name || '-' %></td>
        <td class="td font-semibold"><%= money(r.amount) %></td>
        <td class="td font-mono text-xs"><%= r.txn_id || '-' %></td>
        <td class="td"><%- statusBadge(r.status) %></td>
        <td class="td text-xs text-slate-500 max-w-[200px] truncate" title="<%= r.admin_note || '' %>"><%= r.admin_note || '-' %></td>
        <td class="td text-slate-500 whitespace-nowrap"><%= dt(r.created_at) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>

<%- include('../partials/shell_end') %>
