<%- include('../partials/shell_start', { panel: 'user', active: 'password' }) %>
<h1 class="text-2xl font-bold mb-6">Change password</h1>
<div class="card p-6 max-w-md">
  <form method="POST" action="/account/password" class="space-y-4">
    <div>
      <label class="text-sm font-semibold">Current password</label>
      <input class="input mt-1" type="password" name="current_password" required autocomplete="current-password">
    </div>
    <div>
      <label class="text-sm font-semibold">New password</label>
      <input class="input mt-1" type="password" name="new_password" required minlength="6" autocomplete="new-password">
    </div>
    <div>
      <label class="text-sm font-semibold">Confirm new password</label>
      <input class="input mt-1" type="password" name="confirm_password" required minlength="6" autocomplete="new-password">
    </div>
    <button class="btn btn-primary" type="submit">Update password</button>
  </form>
</div>
<%- include('../partials/shell_end') %>
