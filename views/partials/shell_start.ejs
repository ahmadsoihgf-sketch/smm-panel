<%
// params: panel ('user'|'admin'), active (nav key)
const isAdmin = panel === 'admin';
const nav = isAdmin ? [
  { key: 'dashboard', label: 'Dashboard', href: '/admin', icon: '▦' },
  { key: 'orders', label: 'Orders', href: '/admin/orders', icon: '🧾' },
  { key: 'services', label: 'Services', href: '/admin/services', icon: '🛠' },
  { key: 'categories', label: 'Categories', href: '/admin/categories', icon: '🗂' },
  { key: 'providers', label: 'Providers', href: '/admin/providers', icon: '🔌' },
  { key: 'funds', label: 'Fund Requests', href: '/admin/funds', icon: '💰' },
  { key: 'payments', label: 'Payment Methods', href: '/admin/payments', icon: '🏦' },
  { key: 'users', label: 'Users', href: '/admin/users', icon: '👥' },
  { key: 'announcements', label: 'Announcements', href: '/admin/announcements', icon: '📢' },
  { key: 'tickets', label: 'Tickets', href: '/admin/tickets', icon: '🎫' },
  { key: 'settings', label: 'Settings', href: '/admin/settings', icon: '⚙' },
] : [
  { key: 'dashboard', label: 'Dashboard', href: '/dashboard', icon: '▦' },
  { key: 'order', label: 'New Order', href: '/order/new', icon: '＋' },
  { key: 'orders', label: 'My Orders', href: '/orders', icon: '🧾' },
  { key: 'funds', label: 'Add Funds', href: '/funds/add', icon: '💰' },
  { key: 'fundshistory', label: 'Fund History', href: '/funds/history', icon: '📜' },
  { key: 'tickets', label: 'Support', href: '/tickets', icon: '🎫' },
  { key: 'api', label: 'API', href: '/api', icon: '🔌' },
  { key: 'password', label: 'Password', href: '/account/password', icon: '🔒' },
];
const siteName = (typeof settings !== 'undefined' && settings.site_name) ? settings.site_name : 'SMM Panel';
%>
<body class="bg-slate-100 text-slate-800">
<div class="min-h-screen md:flex">

  <!-- Sidebar (desktop) -->
  <aside class="hidden md:flex flex-col w-64 shrink-0 bg-slate-900 text-slate-200 fixed inset-y-0 z-20">
    <a href="<%= isAdmin ? '/admin' : '/dashboard' %>" class="px-5 py-5 flex items-center gap-2 border-b border-slate-800">
      <span class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-black text-lg">B</span>
      <span class="font-bold text-white text-lg tracking-tight"><%= siteName %></span>
    </a>
    <nav class="flex-1 overflow-y-auto p-3 space-y-1">
      <% nav.forEach(function(n){ %>
        <a href="<%= n.href %>" class="sidebar-link <%= active === n.key ? 'active' : '' %>"><span class="w-5 text-center"><%= n.icon %></span><%= n.label %></a>
      <% }) %>
    </nav>
    <div class="p-4 border-t border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-indigo-600 flex items-center justify-center text-white font-bold"><%= currentUser.username.charAt(0).toUpperCase() %></div>
        <div class="min-w-0">
          <div class="text-sm font-semibold text-white truncate"><%= currentUser.username %></div>
          <div class="text-xs text-slate-400"><%= money(currentUser.balance) %> <%= settings.currency %></div>
        </div>
      </div>
      <div class="flex gap-2 mt-3">
        <% if (!isAdmin && currentUser.role === 'admin') { %>
          <a href="/admin" class="btn btn-sm btn-slate flex-1">Admin</a>
        <% } %>
        <a href="/logout" class="btn btn-sm btn-slate flex-1">Log out</a>
      </div>
    </div>
  </aside>

  <!-- Main -->
  <div class="flex-1 md:ml-64 min-w-0">
    <!-- Mobile top bar -->
    <header class="md:hidden bg-slate-900 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-10">
      <span class="font-bold"><%= siteName %></span>
      <span class="text-xs bg-slate-800 px-2 py-1 rounded"><%= money(currentUser.balance) %> <%= settings.currency %></span>
    </header>
    <nav class="md:hidden bg-slate-900 border-t border-slate-800 px-3 pb-3 flex gap-2 overflow-x-auto">
      <% nav.forEach(function(n){ %>
        <a href="<%= n.href %>" class="whitespace-nowrap text-xs px-3 py-2 rounded-lg <%= active === n.key ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-300' %>"><%= n.label %></a>
      <% }) %>
      <a href="/logout" class="whitespace-nowrap text-xs px-3 py-2 rounded-lg bg-slate-800 text-slate-300">Log out</a>
    </nav>

    <main class="p-4 md:p-8 max-w-6xl mx-auto">
      <%- include('flash') %>
