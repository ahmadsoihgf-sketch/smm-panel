<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= (typeof title !== 'undefined' && title ? title + ' | ' : '') + (typeof settings !== 'undefined' && settings.site_name ? settings.site_name : 'SMM Panel') %></title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body { font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .sidebar-link { display:flex; align-items:center; gap:.65rem; padding:.6rem .9rem; border-radius:.6rem; color:#cbd5e1; font-size:.9rem; font-weight:500; transition:all .15s; }
  .sidebar-link:hover { background:#1e293b; color:#fff; }
  .sidebar-link.active { background:#4f46e5; color:#fff; }
  .card { background:#fff; border-radius:1rem; box-shadow:0 1px 3px rgba(0,0,0,.08); border:1px solid #e2e8f0; }
  .input { width:100%; border:1px solid #cbd5e1; border-radius:.6rem; padding:.6rem .8rem; font-size:.9rem; background:#fff; }
  .input:focus { outline:none; border-color:#4f46e5; box-shadow:0 0 0 3px rgba(79,70,229,.15); }
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; border-radius:.6rem; font-weight:600; font-size:.875rem; padding:.6rem 1.1rem; transition:all .15s; cursor:pointer; }
  .btn-primary { background:#4f46e5; color:#fff; } .btn-primary:hover { background:#4338ca; }
  .btn-green { background:#16a34a; color:#fff; } .btn-green:hover { background:#15803d; }
  .btn-red { background:#dc2626; color:#fff; } .btn-red:hover { background:#b91c1c; }
  .btn-slate { background:#e2e8f0; color:#334155; } .btn-slate:hover { background:#cbd5e1; }
  .btn-sm { padding:.35rem .7rem; font-size:.75rem; }
  .th { text-align:left; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; color:#64748b; font-weight:700; padding:.6rem .8rem; background:#f8fafc; }
  .td { padding:.65rem .8rem; font-size:.875rem; border-top:1px solid #f1f5f9; vertical-align:middle; }
  pre.instructions { white-space:pre-wrap; font-family:inherit; }
</style>
</head>
