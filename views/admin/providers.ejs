<%- include('../partials/head', { title: 'API Providers' }) %>
<%- include('../partials/shell_start', { panel: 'admin', active: 'providers' }) %>

<h1 class="text-2xl font-bold mb-6">API Providers</h1>

<div class="card p-6 mb-6">
  <h2 class="font-bold mb-4">Add provider</h2>
  <form method="POST" action="/admin/providers" class="grid md:grid-cols-4 gap-4">
    <div><label class="text-sm font-semibold">Name</label><input class="input mt-1" name="name" required placeholder="e.g. Main Supplier"></div>
    <div><label class="text-sm font-semibold">API URL</label><input class="input mt-1" name="api_url" required placeholder="https://provider.com/api/v2"></div>
    <div><label class="text-sm font-semibold">API key</label><input class="input mt-1" name="api_key" required></div>
    <div><label class="text-sm font-semibold">Status</label>
      <select name="status" class="input mt-1"><option value="active">Active</option><option value="inactive">Inactive</option></select></div>
    <div class="md:col-span-4"><button class="btn btn-primary" type="submit">Add provider</button></div>
  </form>
</div>

<div class="space-y-4">
  <% providers.forEach(function(p){ %>
  <div class="card p-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <h3 class="font-bold text-lg"><%= p.name %></h3>
          <%- statusBadge(p.status) %>
        </div>
        <div class="text-xs text-slate-500 font-mono mt-1 break-all"><%= p.api_url %></div>
        <div class="text-xs text-slate-500 mt-1">
          Balance: <span class="font-semibold"><%= p.balance_cache != null ? money(p.balance_cache) : '—' %></span>
          <% if (p.last_sync) { %> · Last sync: <%= dt(p.last_sync) %><% } %>
        </div>
      </div>
      <div class="flex gap-2 flex-wrap">
        <form method="POST" action="/admin/providers/<%= p.id %>/balance"><button class="btn btn-sm btn-slate" type="submit">Check balance</button></form>
        <a href="/admin/providers/<%= p.id %>/sync" class="btn btn-sm btn-primary">Sync services</a>
      </div>
    </div>
    <form method="POST" action="/admin/providers/<%= p.id %>" class="grid md:grid-cols-4 gap-3 mt-4 pt-4 border-t border-slate-100">
      <input class="input" name="name" value="<%= p.name %>" required>
      <input class="input" name="api_url" value="<%= p.api_url %>" required>
      <input class="input" name="api_key" value="<%= p.api_key %>" required>
      <select name="status" class="input">
        <option value="active" <%= p.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= p.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
      <div class="md:col-span-4 flex gap-2">
        <button class="btn btn-sm btn-slate" type="submit">Save</button>
      </div>
    </form>
    <form method="POST" action="/admin/providers/<%= p.id %>/delete" onsubmit="return confirm('Delete this provider?')" class="mt-2">
      <button class="btn btn-sm btn-red" type="submit">Delete provider</button>
    </form>
  </div>
  <% }) %>
  <% if (!providers.length) { %><div class="card p-6 text-sm text-slate-500">No providers yet.</div><% } %>
</div>

<%- include('../partials/shell_end') %>
